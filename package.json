{
  "name": "rap-plus",
  "private": true,
  "version": "1.0.0",
  "description": "RAP+ — Pi extensions & theme pack (bluemon studio, todo system, widget renderer, web search).",
  "type": "module",
  "keywords": ["pi-package"],
  "homepage": "https://github.com/rapelzzz/rap-plus",
  "repository": {
    "type": "git",
