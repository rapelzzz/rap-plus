{
  "name": "@rapelz/rap-plus",
  "version": "1.0.0",
  "license": "MIT",
  "description": "RAP+ — Pi extensions & theme pack (bluemon studio, todo system, widget renderer, web search).",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'extensions/**/*.test.ts'",
    "postinstall": "sh scripts/patch-pi-logo.sh"
  },
  "files": [
    "extensions/",
    "themes/",
    "scripts/",
    "assets/",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/rapelzzz/rap-plus",
  "repository": {
    "type": "git",
    "url": "https://github.com/rapelzzz/rap-plus.git"
  },
  "pi": {
    "extensions": [
      "./extensions/rap-web-search.ts",
      "./extensions/rap-bluemon/index.ts",
      "./extensions/todo/index.ts",
      "./extensions/rap-plan-mode/index.ts",
      "./extensions/rap-subagents/index.ts",
      "./extensions/rap-simplify/index.ts",
      "./extensions/rap-code-review/index.ts",
      "./extensions/rap-lens/index.ts",
      "./extensions/rap-debug-mode/index.ts",
      "./extensions/rap-agent-ide/index.ts",
      "./extensions/rap-bash-renderer.ts",
      "./extensions/rap-big-logo/index.ts",
      "./extensions/rap-toolgate/index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@ast-grep/cli@0.51.0": true
  },
  "optionalDependencies": {
    "@ast-grep/cli": "^0.51.0"
  }
}
